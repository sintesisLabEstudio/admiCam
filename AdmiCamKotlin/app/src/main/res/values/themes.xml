<resources>
    <style name="Theme.AdmiCam" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorPrimaryVariant">@color/azul_oscuro</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/barra</item>
        <item name="android:navigationBarColor">@color/barra</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
    </style>
    <style name="Theme.AdmiCam.Dialogo" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_fondo</item>
        <item name="android:textColor">@color/texto</item>
        <item name="colorSurface">@color/fondo</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorPrimary">@color/azul</item>
        <item name="colorAccent">@color/blanco</item>
        <item name="android:textColorPrimary">@color/blanco</item>
        <item name="android:textColorSecondary">@color/blanco</item>
        <item name="buttonBarButtonStyle">@style/Theme.AdmiCam.Dialogo.Boton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.AdmiCam.Dialogo.Boton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.AdmiCam.Dialogo.Boton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Theme.AdmiCam.Dialogo.Boton</item>
    </style>
    <style name="Theme.AdmiCam.Dialogo.Boton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/blanco</item>
    </style>
</resources>
