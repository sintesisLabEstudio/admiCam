<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo" android:fillViewport="true">
  <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/fondo_cabecera" android:textColor="@color/blanco" android:textSize="20sp" android:textStyle="bold" android:padding="16dp" android:layout_marginBottom="8dp" android:elevation="2dp" android:text="Registro de usuarios"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Usuario" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <EditText android:id="@+id/txtNuevoUsuario" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColorHint="@color/texto_secundario" android:hint="Usuario (máx. 20)" android:maxLength="20" android:singleLine="true" android:textColor="@color/texto" android:textSize="16sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre completo" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <EditText android:id="@+id/txtNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColorHint="@color/texto_secundario" android:hint="Nombre completo" android:maxLength="50" android:singleLine="true" android:textColor="@color/texto" android:textSize="16sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contraseña" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <EditText android:id="@+id/txtNuevaClave" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:textColorHint="@color/texto_secundario" android:hint="Contraseña (máx. 20)" android:maxLength="20" android:singleLine="true" android:textColor="@color/texto" android:textSize="16sp"/>
    <Button android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/azul" android:textColor="@color/blanco" android:text="Registrar usuario"/>
    <TextView android:id="@+id/txtMensaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:layout_marginTop="10dp" android:textColor="@color/azul_oscuro" android:textSize="15sp" android:minHeight="44dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registros (toca uno para cambiar el estado, si corresponde)" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <ListView android:id="@+id/listaRegistros" android:layout_width="match_parent" android:layout_height="320dp" android:dividerHeight="1dp" android:nestedScrollingEnabled="true"/>
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/azul" android:textColor="@color/blanco" android:text="Volver al menú"/>
  </LinearLayout>
</ScrollView>
