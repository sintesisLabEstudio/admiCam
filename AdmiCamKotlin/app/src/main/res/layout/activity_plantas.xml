<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo" android:paddingBottom="16dp">
  <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/fondo_cabecera" android:textColor="@color/blanco" android:textSize="20sp" android:textStyle="bold" android:padding="16dp" android:layout_marginBottom="8dp" android:elevation="2dp" android:text="Registro de plantas"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre de planta" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="6dp" android:paddingBottom="2dp"/>
    <EditText android:id="@+id/txtNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColorHint="@color/blanco" android:hint="Ingrese nombre de planta" android:maxLength="50" android:singleLine="true" android:textColor="@color/texto" android:textSize="16sp"/>
    <Button android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:backgroundTint="@color/azul" android:textColor="@color/blanco" android:text="Registrar planta"/>
    <TextView android:id="@+id/txtMensaje" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="2dp" android:layout_marginTop="6dp" android:textColor="@color/blanco" android:textSize="15sp" android:minHeight="0dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Plantas registradas" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="6dp" android:paddingBottom="2dp"/>
    <ListView android:id="@+id/listaRegistros" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:nestedScrollingEnabled="true"/>
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:backgroundTint="@color/azul" android:textColor="@color/blanco" android:text="Volver al menú"/>
  </LinearLayout>
</LinearLayout>