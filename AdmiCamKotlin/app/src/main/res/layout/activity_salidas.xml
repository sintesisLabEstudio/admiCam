<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo" android:fillViewport="true">
  <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/fondo_cabecera" android:textColor="@color/blanco" android:textSize="20sp" android:textStyle="bold" android:padding="16dp" android:layout_marginBottom="8dp" android:elevation="2dp" android:text="Registro de salidas y retornos"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fecha de salida" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <Button android:id="@+id/btnFecha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/azul" android:textColor="@color/blanco" android:text="Seleccionar fecha"/>
    <TextView android:id="@+id/txtFecha" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fecha no elegida" android:textSize="17sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Planta de salida" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <Spinner android:id="@+id/spPlanta" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Camión disponible según planta" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <Spinner android:id="@+id/spCamion" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conductor disponible" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <Spinner android:id="@+id/spChofer" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown"/>
    <Button android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/azul" android:textColor="@color/blanco" android:text="Registrar salida EN RUTA"/>
    <TextView android:id="@+id/txtMensaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:layout_marginTop="10dp" android:textColor="@color/azul_oscuro" android:textSize="15sp" android:minHeight="44dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Historial de salidas (toca EN RUTA para registrar retorno)" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <ListView android:id="@+id/listaRegistros" android:layout_width="match_parent" android:layout_height="400dp" android:nestedScrollingEnabled="true"/>
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/azul" android:textColor="@color/blanco" android:text="Volver al menú"/>
  </LinearLayout>
</ScrollView>
