<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_cabecera"
            android:elevation="2dp"
            android:padding="16dp"
            android:text="AdmiCam | Iniciar sesión"
            android:textColor="@color/blanco"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="Usuario"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/txtUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese usuario"
            android:inputType="text"
            android:maxLength="20"
            android:singleLine="true"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_secundario"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="Contraseña"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/txtPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese contraseña"
            android:inputType="textPassword"
            android:maxLength="20"
            android:singleLine="true"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_secundario"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul"
            android:text="Ingresar"
            android:textColor="@color/blanco" />

        <Button
            android:id="@+id/btnLimpiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/azul"
            android:text="Limpiar"
            android:textColor="@color/blanco" />

        <TextView
            android:id="@+id/txtMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="32dp"
            android:padding="8dp"
            android:textColor="@color/azul_oscuro"
            android:textSize="14sp" />

        <!-- Usa el espacio disponible para colocar el bloque academico abajo. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/fondo_info_institucional"
            android:orientation="vertical"
            android:padding="11dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_logo_institucional"
                android:padding="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:contentDescription="Logo Instituto Profesional Virginio Gómez"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_virginio_gomez" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="Jorge Vera  ·  Ignacio Gaete"
                android:textColor="@color/texto"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="Técnico Analista Programador"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="Profesor: Roberto Cisterna Figueroa"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
