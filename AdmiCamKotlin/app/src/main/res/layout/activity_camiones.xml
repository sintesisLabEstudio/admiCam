<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo" android:fillViewport="true">
  <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/fondo_cabecera" android:textColor="@color/blanco" android:textSize="20sp" android:textStyle="bold" android:padding="16dp" android:layout_marginBottom="8dp" android:elevation="2dp" android:text="Registro de camiones"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Código alfanumérico (máximo 10)" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <EditText android:id="@+id/txtCodigo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColorHint="@color/texto_secundario" android:hint="Código de camión" android:maxLength="10" android:singleLine="true" android:textColor="@color/texto" android:textSize="16sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Planta" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <Spinner android:id="@+id/spPlanta" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estado" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <Spinner android:id="@+id/spEstado" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown"/>
    <Button android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/azul" android:textColor="@color/blanco" android:text="Registrar camión"/>
    <TextView android:id="@+id/txtMensaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:layout_marginTop="10dp" android:textColor="@color/azul_oscuro" android:textSize="15sp" android:minHeight="44dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registros (toca uno para cambiar el estado, si corresponde)" android:textSize="15sp" android:textColor="@color/texto" android:paddingTop="10dp" android:paddingBottom="4dp"/>
    <ListView android:id="@+id/listaRegistros" android:layout_width="match_parent" android:layout_height="320dp" android:dividerHeight="1dp" android:nestedScrollingEnabled="true"/>
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/azul" android:textColor="@color/blanco" android:text="Volver al menú"/>
  </LinearLayout>
</ScrollView>
